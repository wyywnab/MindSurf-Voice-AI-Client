{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindsurf.dev/schemas/voice/v2/server-messages.schema.json",
  "title": "MindSurf Voice v2 server-to-client control messages",
  "oneOf": [
    { "$ref": "#/$defs/serverHello" },
    { "$ref": "#/$defs/sessionPing" },
    { "$ref": "#/$defs/requestAccepted" },
    { "$ref": "#/$defs/inputCommitted" },
    { "$ref": "#/$defs/outputTextDelta" },
    { "$ref": "#/$defs/outputTextSnapshot" },
    { "$ref": "#/$defs/requestDone" },
    { "$ref": "#/$defs/requestCancelled" },
    { "$ref": "#/$defs/errorMessage" }
  ],
  "$defs": {
    "serverHello": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/sessionEnvelope" },
        {
          "properties": {
            "type": { "const": "server.hello" },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "required": ["session_id", "protocol_version", "input_audio", "heartbeat_interval_ms", "heartbeat_timeout_ms", "input_idle_timeout_ms", "limits"],
              "properties": {
                "session_id": { "$ref": "envelope.schema.json#/$defs/uuid" },
                "protocol_version": { "const": 2 },
                "input_audio": { "$ref": "common/audio.schema.json#/$defs/inputAudioFormat" },
                "heartbeat_interval_ms": { "type": "integer", "minimum": 1000 },
                "heartbeat_timeout_ms": { "type": "integer", "minimum": 1000 },
                "input_idle_timeout_ms": { "type": "integer", "minimum": 1000 },
                "limits": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["max_control_bytes", "max_binary_bytes", "max_recording_ms"],
                  "properties": {
                    "max_control_bytes": { "type": "integer", "minimum": 1024 },
                    "max_binary_bytes": { "type": "integer", "minimum": 50 },
                    "max_recording_ms": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "sessionPing": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/sessionEnvelope" },
        {
          "properties": {
            "type": { "const": "session.ping" },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "required": ["nonce"],
              "properties": { "nonce": { "type": "string", "minLength": 1, "maxLength": 256 } }
            }
          }
        }
      ]
    },
    "acceptedPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "pipeline", "capabilities_revision", "selection", "language", "max_recording_ms", "quota_reservation"],
      "properties": {
        "mode": { "$ref": "common/request.schema.json#/$defs/mode" },
        "pipeline": { "type": "string", "minLength": 1 },
        "capabilities_revision": { "type": "string", "minLength": 1 },
        "selection": { "$ref": "common/request.schema.json#/$defs/selection" },
        "language": { "type": "string", "minLength": 1 },
        "generation": { "$ref": "common/request.schema.json#/$defs/generation" },
        "max_recording_ms": { "type": "integer", "minimum": 1 },
        "quota_reservation": { "$ref": "common/request.schema.json#/$defs/creditBreakdown" }
      },
      "allOf": [
        {
          "not": { "anyOf": [{ "required": ["task"] }, { "required": ["conversation_id"] }, { "required": ["response"] }] }
        },
        {
          "if": { "properties": { "mode": { "const": "asr_only" } }, "required": ["mode"] },
          "then": {
            "properties": { "selection": { "properties": { "llm": { "type": "null" } } } },
            "not": { "required": ["generation"] }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "asr_llm" } }, "required": ["mode"] },
          "then": { "properties": { "selection": { "properties": { "llm": { "type": "string", "minLength": 1 } } } } }
        }
      ]
    },
    "requestAccepted": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        { "properties": { "type": { "const": "request.accepted" }, "payload": { "$ref": "#/$defs/acceptedPayload" } } }
      ]
    },
    "inputCommitted": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        { "properties": { "type": { "const": "input.committed" }, "payload": { "$ref": "common/request.schema.json#/$defs/inputStatistics" } } }
      ]
    },
    "outputTextDelta": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "output.text.delta" },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "required": ["stage", "sequence", "delta"],
              "properties": {
                "stage": { "enum": ["asr", "llm"] },
                "sequence": { "type": "integer", "minimum": 0 },
                "delta": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "outputTextSnapshot": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "output.text.snapshot" },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "required": ["stage", "text", "final"],
              "properties": {
                "stage": { "enum": ["asr", "llm"] },
                "text": { "type": "string" },
                "final": { "type": "boolean" }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "stage": { "const": "llm" },
                      "final": { "const": false }
                    },
                    "required": ["stage", "final"]
                  },
                  "then": { "properties": { "text": { "const": "" } } }
                }
              ]
            }
          }
        }
      ]
    },
    "requestDone": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "request.done" },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "required": ["result", "mode", "final_text", "usage"],
              "properties": {
                "result": { "const": "success" },
                "mode": { "$ref": "common/request.schema.json#/$defs/mode" },
                "final_text": { "type": "string" },
                "usage": { "$ref": "common/request.schema.json#/$defs/usage" }
              }
            }
          }
        }
      ]
    },
    "requestCancelled": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "request.cancelled" },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "required": ["reason", "usage"],
              "properties": {
                "reason": { "enum": ["user_cancelled", "client_timeout", "network_congestion", "protocol_error"] },
                "usage": { "$ref": "common/request.schema.json#/$defs/usage" }
              }
            }
          }
        }
      ]
    },
    "errorMessage": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/baseEnvelope" },
        { "properties": { "type": { "const": "error" }, "payload": { "$ref": "common/errors.schema.json#/$defs/errorPayload" } } },
        {
          "oneOf": [
            {
              "properties": {
                "request_id": { "type": "null" },
                "payload": {
                  "properties": { "terminal": { "const": false } },
                  "not": { "required": ["usage"] }
                }
              }
            },
            {
              "properties": {
                "request_id": { "$ref": "envelope.schema.json#/$defs/uuid" },
                "payload": {
                  "required": ["usage"],
                  "properties": { "terminal": { "const": true }, "fatal": { "const": false } }
                }
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "payload": {
                "properties": { "code": { "enum": ["protocol_version_mismatch", "handshake_required"] } },
                "required": ["code"]
              }
            },
            "required": ["payload"]
          },
          "then": {
            "properties": {
              "request_id": { "type": "null" },
              "payload": {
                "properties": {
                  "terminal": { "const": false },
                  "retryable": { "const": false },
                  "fatal": { "const": true }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "payload": {
                "properties": {
                  "code": {
                    "enum": [
                      "request_in_progress",
                      "request_not_found",
                      "request_id_reused",
                      "capabilities_stale",
                      "pipeline_unavailable",
                      "unsupported_mode",
                      "invalid_selection",
                      "quota_exhausted",
                      "rate_limit_exceeded",
                      "input_empty",
                      "input_idle_timeout",
                      "invalid_audio_frame",
                      "input_statistics_mismatch",
                      "recording_limit_exceeded",
                      "asr_failed",
                      "llm_failed",
                      "request_timeout",
                      "upstream_unavailable"
                    ]
                  }
                },
                "required": ["code"]
              }
            },
            "required": ["payload"]
          },
          "then": { "properties": { "request_id": { "$ref": "envelope.schema.json#/$defs/uuid" } } }
        },
        {
          "if": {
            "properties": {
              "payload": {
                "properties": {
                  "code": {
                    "enum": [
                      "capabilities_stale",
                      "pipeline_unavailable",
                      "rate_limit_exceeded",
                      "asr_failed",
                      "llm_failed",
                      "request_timeout",
                      "upstream_unavailable",
                      "server_error"
                    ]
                  }
                },
                "required": ["code"]
              }
            },
            "required": ["payload"]
          },
          "then": {
            "properties": {
              "payload": {
                "properties": {
                  "retryable": { "const": true }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "payload": {
                "properties": {
                  "code": {
                    "enum": [
                      "invalid_message",
                      "unsupported_message_type",
                      "protocol_version_mismatch",
                      "handshake_required",
                      "request_in_progress",
                      "request_not_found",
                      "request_id_reused",
                      "unsupported_mode",
                      "invalid_selection",
                      "quota_exhausted",
                      "input_empty",
                      "input_idle_timeout",
                      "invalid_audio_frame",
                      "input_statistics_mismatch",
                      "recording_limit_exceeded",
                      "session_revoked"
                    ]
                  }
                },
                "required": ["code"]
              }
            },
            "required": ["payload"]
          },
          "then": {
            "properties": {
              "payload": {
                "properties": {
                  "retryable": { "const": false }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "request_id": { "type": "null" },
              "payload": {
                "properties": { "code": { "const": "server_error" } },
                "required": ["code"]
              }
            },
            "required": ["request_id", "payload"]
          },
          "then": {
            "properties": {
              "payload": {
                "properties": {
                  "fatal": { "const": true }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "payload": {
                "properties": { "code": { "enum": ["invalid_message", "unsupported_message_type"] } },
                "required": ["code"]
              }
            },
            "required": ["payload"]
          },
          "then": {
            "properties": {
              "payload": {
                "properties": {
                  "fatal": { "const": false }
                }
              }
            }
          }
        }
      ]
    }
  }
}
