{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindsurf.dev/schemas/voice/v2/server-messages.schema.json",
  "title": "MindSurf Voice v2 server-to-client control messages",
  "oneOf": [
    { "$ref": "#/$defs/serverHello" },
    { "$ref": "#/$defs/sessionPing" },
    { "$ref": "#/$defs/requestAccepted" },
    { "$ref": "#/$defs/inputCommitted" },
    { "$ref": "#/$defs/inputTranscriptDelta" },
    { "$ref": "#/$defs/inputTranscriptDone" },
    { "$ref": "#/$defs/assistantTextDelta" },
    { "$ref": "#/$defs/assistantTextDone" },
    { "$ref": "#/$defs/outputAudioStart" },
    { "$ref": "#/$defs/outputAudioDone" },
    { "$ref": "#/$defs/requestDone" },
    { "$ref": "#/$defs/requestCancelled" },
    { "$ref": "#/$defs/errorMessage" }
  ],
  "$defs": {
    "serverIdentity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "max_recording_ms",
        "max_json_bytes",
        "max_binary_bytes",
        "max_concurrent_requests"
      ],
      "properties": {
        "max_recording_ms": { "type": "integer", "minimum": 1 },
        "max_json_bytes": { "const": 65536 },
        "max_binary_bytes": { "type": "integer", "minimum": 50 },
        "max_concurrent_requests": { "const": 1 }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "request_accept_timeout_ms",
        "input_idle_timeout_ms",
        "input_commit_timeout_ms",
        "dictation_completion_timeout_ms",
        "assistant_first_output_timeout_ms",
        "assistant_first_audio_timeout_ms",
        "request_total_timeout_ms",
        "cancel_stop_target_ms",
        "cancel_timeout_ms",
        "connection_idle_timeout_ms"
      ],
      "properties": {
        "request_accept_timeout_ms": { "type": "integer", "minimum": 1 },
        "input_idle_timeout_ms": { "type": "integer", "minimum": 1 },
        "input_commit_timeout_ms": { "type": "integer", "minimum": 1 },
        "dictation_completion_timeout_ms": { "type": "integer", "minimum": 1 },
        "assistant_first_output_timeout_ms": { "type": "integer", "minimum": 1 },
        "assistant_first_audio_timeout_ms": { "type": "integer", "minimum": 1 },
        "request_total_timeout_ms": { "type": "integer", "minimum": 1 },
        "cancel_stop_target_ms": { "type": "integer", "minimum": 1 },
        "cancel_timeout_ms": { "type": "integer", "minimum": 1 },
        "connection_idle_timeout_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": true,
      "required": ["interval_ms", "timeout_ms"],
      "properties": {
        "interval_ms": { "type": "integer", "minimum": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "serverHelloPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "session_id",
        "server",
        "protocol_version",
        "input_audio",
        "output_audio",
        "limits",
        "timeouts",
        "heartbeat"
      ],
      "properties": {
        "session_id": { "$ref": "envelope.schema.json#/$defs/uuid" },
        "server": { "$ref": "#/$defs/serverIdentity" },
        "protocol_version": { "const": 2 },
        "input_audio": { "$ref": "common/audio.schema.json#/$defs/inputAudioFormat" },
        "output_audio": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common/audio.schema.json#/$defs/outputAudioFormat" }
        },
        "limits": { "$ref": "#/$defs/limits" },
        "timeouts": { "$ref": "#/$defs/timeouts" },
        "heartbeat": { "$ref": "#/$defs/heartbeat" }
      }
    },
    "serverHello": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/sessionEnvelope" },
        {
          "properties": {
            "type": { "const": "server.hello" },
            "payload": { "$ref": "#/$defs/serverHelloPayload" }
          }
        }
      ]
    },
    "sessionPing": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/sessionEnvelope" },
        {
          "properties": {
            "type": { "const": "session.ping" },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "required": ["nonce"],
              "properties": {
                "nonce": { "type": "string", "minLength": 1, "maxLength": 256 }
              }
            }
          }
        }
      ]
    },
    "requestAcceptedPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "pipeline", "capabilities_revision", "selection", "conversation_id", "language", "response", "max_recording_ms"],
      "properties": {
        "mode": { "enum": ["dictation", "assistant"] },
        "pipeline": { "type": "string", "minLength": 1 },
        "capabilities_revision": { "type": "string", "minLength": 1 },
        "selection": { "$ref": "common/request.schema.json#/$defs/selection" },
        "conversation_id": {
          "oneOf": [
            { "$ref": "envelope.schema.json#/$defs/uuid" },
            { "type": "null" }
          ]
        },
        "language": { "type": "string", "minLength": 1 },
        "response": { "$ref": "common/request.schema.json#/$defs/responseConfig" },
        "generation": { "$ref": "common/request.schema.json#/$defs/generation" },
        "max_recording_ms": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "dictation" } },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "conversation_id": { "type": "null" },
              "response": {
                "properties": {
                  "input_transcription": { "const": true },
                  "text": { "const": false },
                  "audio": { "const": false }
                }
              },
              "selection": {
                "properties": {
                  "llm": { "type": "null" },
                  "tts": { "type": "null" }
                }
              }
            },
            "not": { "required": ["generation"] }
          }
        },
        {
          "if": {
            "properties": { "mode": { "const": "assistant" } },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "response": {
                "anyOf": [
                  {
                    "properties": { "text": { "const": true } },
                    "required": ["text"]
                  },
                  {
                    "properties": { "audio": { "const": true } },
                    "required": ["audio"]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "response": {
                "properties": { "text": { "const": false } },
                "required": ["text"]
              }
            },
            "required": ["response"]
          },
          "then": {
            "properties": {
              "generation": { "not": { "required": ["text"] } }
            }
          }
        },
        {
          "if": {
            "properties": {
              "response": {
                "properties": { "audio": { "const": false } },
                "required": ["audio"]
              }
            },
            "required": ["response"]
          },
          "then": {
            "properties": {
              "generation": { "not": { "required": ["audio"] } }
            }
          }
        }
      ]
    },
    "requestAccepted": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "request.accepted" },
            "payload": { "$ref": "#/$defs/requestAcceptedPayload" }
          }
        }
      ]
    },
    "inputStatistics": {
      "type": "object",
      "additionalProperties": true,
      "required": ["frame_count", "sample_count", "duration_ms"],
      "properties": {
        "frame_count": { "type": "integer", "minimum": 1 },
        "sample_count": { "type": "integer", "minimum": 1 },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "inputCommitted": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "input.committed" },
            "payload": { "$ref": "#/$defs/inputStatistics" }
          }
        }
      ]
    },
    "inputTranscriptDelta": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "input.transcript.delta" },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "required": ["text", "revision", "stable_prefix_length"],
              "properties": {
                "text": { "type": "string" },
                "revision": { "type": "integer", "minimum": 0 },
                "stable_prefix_length": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      ]
    },
    "inputTranscriptDone": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "input.transcript.done" },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "required": ["text", "language", "confidence", "duration_ms", "finish_reason"],
              "properties": {
                "text": { "type": "string" },
                "language": { "type": "string", "minLength": 1 },
                "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
                "duration_ms": { "type": "integer", "minimum": 0 },
                "finish_reason": { "enum": ["stop", "error"] }
              }
            }
          }
        }
      ]
    },
    "assistantTextDelta": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "assistant.text.delta" },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "required": ["sequence", "delta"],
              "properties": {
                "sequence": { "type": "integer", "minimum": 0 },
                "delta": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "assistantTextDonePayload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["text", "last_sequence", "finish_reason", "usage"],
      "properties": {
        "text": { "type": "string" },
        "last_sequence": { "type": ["integer", "null"], "minimum": 0 },
        "finish_reason": { "enum": ["stop", "error"] },
        "usage": {
          "type": ["object", "null"],
          "required": ["input_tokens", "output_tokens"],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "finish_reason": { "const": "error" } },
            "required": ["finish_reason"]
          },
          "then": {
            "properties": {
              "last_sequence": { "type": "integer", "minimum": 0 }
            }
          }
        }
      ]
    },
    "assistantTextDone": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "assistant.text.done" },
            "payload": { "$ref": "#/$defs/assistantTextDonePayload" }
          }
        }
      ]
    },
    "outputAudioStartPayload": {
      "allOf": [
        { "$ref": "common/audio.schema.json#/$defs/outputAudioStartFormat" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["voice", "emotion"],
          "properties": {
            "voice": { "type": ["string", "null"], "minLength": 1 },
            "emotion": {
              "oneOf": [
                { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    },
    "outputAudioStart": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "output.audio.start" },
            "payload": { "$ref": "#/$defs/outputAudioStartPayload" }
          }
        }
      ]
    },
    "outputAudioDonePayload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["last_sequence", "chunk_count", "sample_count", "duration_ms", "finish_reason"],
      "properties": {
        "last_sequence": { "type": ["integer", "null"], "minimum": 0 },
        "chunk_count": { "type": "integer", "minimum": 0 },
        "sample_count": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "finish_reason": { "enum": ["stop", "error"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "finish_reason": { "const": "stop" } },
            "required": ["finish_reason"]
          },
          "then": {
            "properties": {
              "last_sequence": { "type": "integer", "minimum": 0 },
              "chunk_count": { "type": "integer", "minimum": 1 },
              "sample_count": { "type": "integer", "minimum": 1 },
              "duration_ms": { "type": "integer", "minimum": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "last_sequence": { "type": "null" } },
            "required": ["last_sequence"]
          },
          "then": {
            "properties": {
              "chunk_count": { "const": 0 },
              "sample_count": { "const": 0 },
              "duration_ms": { "const": 0 },
              "finish_reason": { "const": "error" }
            }
          }
        }
      ]
    },
    "outputAudioDone": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "output.audio.done" },
            "payload": { "$ref": "#/$defs/outputAudioDonePayload" }
          }
        }
      ]
    },
    "requestDonePayload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["result", "conversation_id", "requested", "completed", "failures", "usage", "context"],
      "properties": {
        "result": { "enum": ["success", "partial"] },
        "conversation_id": {
          "oneOf": [
            { "$ref": "envelope.schema.json#/$defs/uuid" },
            { "type": "null" }
          ]
        },
        "requested": { "$ref": "common/request.schema.json#/$defs/streamSwitches" },
        "completed": { "$ref": "common/request.schema.json#/$defs/streamSwitches" },
        "failures": { "$ref": "common/request.schema.json#/$defs/failureMap" },
        "usage": { "$ref": "common/request.schema.json#/$defs/usage" },
        "context": {
          "oneOf": [
            { "$ref": "common/request.schema.json#/$defs/context" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "result": { "const": "success" } },
            "required": ["result"]
          },
          "then": {
            "properties": {
              "failures": { "maxProperties": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "result": { "const": "partial" } },
            "required": ["result"]
          },
          "then": {
            "properties": {
              "failures": { "minProperties": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "conversation_id": { "type": "null" } },
            "required": ["conversation_id"]
          },
          "then": {
            "properties": { "context": { "type": "null" } }
          },
          "else": {
            "properties": { "context": { "$ref": "common/request.schema.json#/$defs/context" } }
          }
        }
      ]
    },
    "requestDone": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "request.done" },
            "payload": { "$ref": "#/$defs/requestDonePayload" }
          }
        }
      ]
    },
    "requestCancelled": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "request.cancelled" },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "required": ["reason", "conversation_id"],
              "properties": {
                "reason": {
                  "enum": [
                    "user_cancelled",
                    "user_interrupted",
                    "client_timeout",
                    "network_congestion",
                    "protocol_error"
                  ]
                },
                "conversation_id": {
                  "oneOf": [
                    { "$ref": "envelope.schema.json#/$defs/uuid" },
                    { "type": "null" }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "errorMessage": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/baseEnvelope" },
        {
          "properties": {
            "type": { "const": "error" },
            "payload": { "$ref": "common/errors.schema.json#/$defs/errorPayload" }
          }
        },
        {
          "if": {
            "properties": {
              "request_id": { "type": "null" },
              "payload": {
                "properties": { "code": { "enum": ["invalid_message", "unsupported_message_type"] } },
                "required": ["code"]
              }
            },
            "required": ["request_id", "payload"]
          },
          "then": {
            "properties": {
              "payload": {
                "properties": {
                  "stream": { "type": "null" }, "terminal": { "const": false },
                  "retryable": { "const": false }, "fatal": { "const": true }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "request_id": { "type": "string" },
              "payload": {
                "properties": { "code": { "enum": ["invalid_message", "unsupported_message_type"] } },
                "required": ["code"]
              }
            },
            "required": ["request_id", "payload"]
          },
          "then": {
            "properties": {
              "payload": {
                "properties": {
                  "stream": { "type": "null" }, "terminal": { "const": true },
                  "retryable": { "const": false }, "fatal": { "const": false }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "request_id": { "type": "null" } },
            "required": ["request_id"]
          },
          "then": {
            "properties": {
              "payload": {
                "properties": {
                  "stream": { "type": "null" },
                  "terminal": { "const": false }
                }
              }
            }
          },
          "else": {
            "properties": {
              "request_id": { "$ref": "envelope.schema.json#/$defs/uuid" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "payload": {
                "properties": {
                  "code": {
                    "enum": [
                      "authentication_required",
                      "authentication_failed",
                      "authentication_expired",
                      "protocol_version_mismatch",
                      "transport_negotiation_failed"
                    ]
                  }
                },
                "required": ["code"]
              }
            },
            "required": ["payload"]
          },
          "then": {
            "properties": {
              "request_id": { "type": "null" },
              "payload": {
                "properties": {
                  "stream": { "type": "null" },
                  "terminal": { "const": false },
                  "retryable": { "const": false },
                  "fatal": { "const": true }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "payload": {
                "properties": {
                  "code": {
                    "enum": [
                      "permission_denied", "quota_exceeded", "rate_limited", "pipeline_unavailable", "capabilities_stale",
                      "unsupported_pipeline", "unsupported_model", "unsupported_feature",
                      "unsupported_inference_option", "unsupported_output_audio", "unsupported_language",
                      "request_already_active", "request_not_found", "audio_sequence_error", "input_too_long",
                      "input_empty", "input_idle_timeout", "input_statistics_mismatch", "request_accept_timeout",
                      "input_commit_timeout", "transcription_timeout", "generation_timeout",
                      "output_audio_timeout", "request_timeout", "transcription_failed", "generation_failed",
                      "output_audio_failed", "voice_not_found", "voice_not_ready", "voice_not_selectable",
                      "emotion_reference_not_found", "conversation_not_found", "conversation_active",
                      "conversation_configuration_mismatch", "upstream_unavailable"
                    ]
                  }
                },
                "required": ["code"]
              }
            },
            "required": ["payload"]
          },
          "then": {
            "properties": { "request_id": { "$ref": "envelope.schema.json#/$defs/uuid" } }
          }
        },
        {
          "if": {
            "properties": {
              "request_id": { "type": "null" },
              "payload": {
                "properties": { "code": { "const": "server_error" } },
                "required": ["code"]
              }
            },
            "required": ["request_id", "payload"]
          },
          "then": {
            "properties": {
              "payload": {
                "properties": {
                  "stream": { "type": "null" }, "terminal": { "const": false },
                  "retryable": { "const": false }, "fatal": { "const": true }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "request_id": { "type": "string" },
              "payload": {
                "properties": { "code": { "const": "server_error" } },
                "required": ["code"]
              }
            },
            "required": ["request_id", "payload"]
          },
          "then": {
            "properties": {
              "payload": {
                "properties": {
                  "stream": { "type": "null" }, "terminal": { "const": true },
                  "retryable": { "const": true }, "fatal": { "const": false }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "payload": {
                "properties": { "stream": { "type": "string" } },
                "required": ["stream"]
              }
            }
          },
          "then": {
            "properties": {
              "request_id": { "$ref": "envelope.schema.json#/$defs/uuid" },
              "payload": {
                "properties": {
                  "terminal": { "const": false },
                  "retryable": { "const": false },
                  "fatal": { "const": false }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "request_id": { "type": "string" },
              "payload": {
                "properties": {
                  "terminal": { "const": true },
                  "code": {
                    "enum": [
                      "transcription_failed", "transcription_timeout", "generation_failed",
                      "generation_timeout", "output_audio_failed", "output_audio_timeout",
                      "request_timeout"
                    ]
                  }
                },
                "required": ["terminal", "code"]
              }
            },
            "required": ["request_id", "payload"]
          },
          "then": {
            "properties": {
              "payload": { "properties": { "retryable": { "const": true } } }
            }
          }
        },
        {
          "if": {
            "properties": {
              "payload": {
                "properties": { "stream": { "const": "input_transcription" } },
                "required": ["stream"]
              }
            },
            "required": ["payload"]
          },
          "then": {
            "properties": {
              "payload": {
                "properties": {
                  "code": { "enum": ["transcription_failed", "transcription_timeout", "request_timeout"] }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "payload": {
