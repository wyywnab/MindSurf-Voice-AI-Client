{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindsurf.dev/schemas/voice/v2/client-messages.schema.json",
  "title": "MindSurf Voice v2 client-to-server control messages",
  "oneOf": [
    { "$ref": "#/$defs/clientHello" },
    { "$ref": "#/$defs/sessionPong" },
    { "$ref": "#/$defs/requestStart" },
    { "$ref": "#/$defs/inputCommit" },
    { "$ref": "#/$defs/requestCancel" }
  ],
  "$defs": {
    "clientIdentity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "version", "platform", "arch"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "clientHello": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/sessionEnvelope" },
        {
          "properties": {
            "type": { "const": "client.hello" },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "required": ["client", "protocol_versions", "input_audio"],
              "properties": {
                "client": { "$ref": "#/$defs/clientIdentity" },
                "protocol_versions": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "contains": { "const": 2 },
                  "items": { "type": "integer", "minimum": 1 }
                },
                "input_audio": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "common/audio.schema.json#/$defs/inputAudioFormat" }
                }
              },
              "not": { "anyOf": [{ "required": ["auth"] }, { "required": ["output_audio"] }] }
            }
          }
        }
      ]
    },
    "sessionPong": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/sessionEnvelope" },
        {
          "properties": {
            "type": { "const": "session.pong" },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "required": ["nonce"],
              "properties": { "nonce": { "type": "string", "minLength": 1, "maxLength": 256 } }
            }
          }
        }
      ]
    },
    "requestStartPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "pipeline", "capabilities_revision", "selection", "language"],
      "properties": {
        "mode": { "$ref": "common/request.schema.json#/$defs/mode" },
        "pipeline": { "type": "string", "minLength": 1 },
        "capabilities_revision": { "type": "string", "minLength": 1 },
        "selection": { "$ref": "common/request.schema.json#/$defs/selection" },
        "language": { "type": "string", "minLength": 1 },
        "generation": { "$ref": "common/request.schema.json#/$defs/generation" }
      },
      "allOf": [
        {
          "not": {
            "anyOf": [
              { "required": ["task"] },
              { "required": ["conversation_id"] },
              { "required": ["response"] },
              { "required": ["voice"] },
              { "required": ["emotion"] },
              { "required": ["output_audio"] }
            ]
          }
        },
        {
          "if": { "properties": { "mode": { "const": "asr_only" } }, "required": ["mode"] },
          "then": {
            "properties": { "selection": { "properties": { "llm": { "type": "null" } } } },
            "not": { "required": ["generation"] }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "asr_llm" } }, "required": ["mode"] },
          "then": {
            "properties": { "selection": { "properties": { "llm": { "type": "string", "minLength": 1 } } } }
          }
        }
      ]
    },
    "requestStart": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        { "properties": { "type": { "const": "request.start" }, "payload": { "$ref": "#/$defs/requestStartPayload" } } }
      ]
    },
    "inputCommit": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        { "properties": { "type": { "const": "input.commit" }, "payload": { "$ref": "common/request.schema.json#/$defs/inputStatistics" } } }
      ]
    },
    "requestCancel": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "request.cancel" },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "required": ["reason"],
              "properties": {
                "reason": { "enum": ["user_cancelled", "client_timeout", "network_congestion", "protocol_error"] }
              }
            }
          }
        }
      ]
    }
  }
}
