{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindsurf.dev/schemas/voice/v2/common/request.schema.json",
  "title": "MindSurf Voice v2 shared request structures",
  "$defs": {
    "nullableString": {
      "type": ["string", "null"]
    },
    "selection": {
      "type": "object",
      "additionalProperties": true,
      "required": ["model", "asr", "llm", "tts"],
      "properties": {
        "model": { "$ref": "#/$defs/nullableString" },
        "asr": { "$ref": "#/$defs/nullableString" },
        "llm": { "$ref": "#/$defs/nullableString" },
        "tts": { "$ref": "#/$defs/nullableString" }
      }
    },
    "responseConfig": {
      "type": "object",
      "additionalProperties": true,
      "required": ["input_transcription", "text", "audio", "output_audio", "voice", "emotion"],
      "properties": {
        "input_transcription": { "type": "boolean" },
        "text": { "type": "boolean" },
        "audio": { "type": "boolean" },
        "output_audio": {
          "oneOf": [
            { "$ref": "audio.schema.json#/$defs/outputFormatId" },
            { "type": "null" }
          ]
        },
        "voice": { "$ref": "#/$defs/nullableString" },
        "emotion": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "audio": { "const": false } },
            "required": ["audio"]
          },
          "then": {
            "properties": {
              "output_audio": { "type": "null" },
              "voice": { "type": "null" },
              "emotion": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "audio": { "const": true } },
            "required": ["audio"]
          },
          "then": {
            "properties": {
              "output_audio": { "$ref": "audio.schema.json#/$defs/outputFormatId" },
              "voice": {
                "oneOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              }
            }
          }
        }
      ]
    },
    "streamSwitches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_transcription", "text", "audio"],
      "properties": {
        "input_transcription": { "type": "boolean" },
        "text": { "type": "boolean" },
        "audio": { "type": "boolean" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "object",
          "additionalProperties": true
        },
        "audio": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["recording_ms", "input_tokens", "output_tokens", "output_audio_ms"],
      "properties": {
        "recording_ms": { "type": ["integer", "null"], "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_audio_ms": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "required": ["retained_turns", "dropped_turns"],
      "properties": {
        "retained_turns": { "type": "integer", "minimum": 0 },
        "dropped_turns": { "type": "integer", "minimum": 0 }
      }
    },
    "streamFailure": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "failureMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_transcription": { "$ref": "#/$defs/streamFailure" },
        "text": { "$ref": "#/$defs/streamFailure" },
        "audio": { "$ref": "#/$defs/streamFailure" }
      }
    }
  }
}
