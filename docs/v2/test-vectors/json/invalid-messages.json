{
  "format_version": 1,
  "cases": [
    {
      "name": "request message cannot use null request_id",
      "expected_rule": "request_id_must_be_uuid",
      "message": {
        "v": 2,
        "type": "request.cancel",
        "event_id": "10000000-0000-4000-8000-000000000001",
        "request_id": null,
        "sent_at_ms": 1,
        "payload": { "reason": "user_cancelled" }
      }
    },
    {
      "name": "session message cannot use request UUID",
      "expected_rule": "session_request_id_must_be_null",
      "message": {
        "v": 2,
        "type": "session.pong",
        "event_id": "10000000-0000-4000-8000-000000000002",
        "request_id": "00112233-4455-6677-8899-aabbccddeeff",
        "sent_at_ms": 2,
        "payload": { "nonce": "ping-1" }
      }
    },
    {
      "name": "unknown control type is not silently accepted",
      "expected_rule": "message_type_must_be_declared",
      "message": {
        "v": 2,
        "type": "request.pause",
        "event_id": "10000000-0000-4000-8000-000000000003",
        "request_id": "00112233-4455-6677-8899-aabbccddeeff",
        "sent_at_ms": 3,
        "payload": { "reason": "user_cancelled" }
      }
    },
    {
      "name": "control envelope requires payload",
      "expected_rule": "payload_is_required",
      "message": {
        "v": 2,
        "type": "input.commit",
        "event_id": "10000000-0000-4000-8000-000000000004",
        "request_id": "00112233-4455-6677-8899-aabbccddeeff",
        "sent_at_ms": 4
      }
    },
    {
      "name": "dictation cannot attach a conversation",
      "expected_rule": "dictation_conversation_id_must_be_null",
      "message": {
        "v": 2,
        "type": "request.start",
        "event_id": "10000000-0000-4000-8000-000000000005",
        "request_id": "00112233-4455-6677-8899-aabbccddeeff",
        "sent_at_ms": 5,
        "payload": {
          "mode": "dictation",
          "pipeline": "cascade",
          "capabilities_revision": "cap_test_1",
          "selection": { "model": null, "asr": "asr-1", "llm": null, "tts": null },
          "conversation_id": "11112222-3333-4444-aaaa-bbbbbbbbbbbb",
          "language": "zh-CN",
          "response": {
            "input_transcription": true,
            "text": false,
            "audio": false,
            "output_audio": null,
            "voice": null,
            "emotion": null
          }
        }
      }
    },
    {
      "name": "generation controls must be channel scoped",
      "expected_rule": "generation_must_be_channel_scoped",
      "message": {
        "v": 2,
        "type": "request.start",
        "event_id": "10000000-0000-4000-8000-000000000006",
        "request_id": "00112233-4455-6677-8899-aabbccddeeff",
        "sent_at_ms": 6,
        "payload": {
          "mode": "assistant",
          "pipeline": "native_audio",
          "capabilities_revision": "cap_test_1",
          "selection": { "model": "model-1", "asr": null, "llm": null, "tts": null },
          "conversation_id": null,
          "language": "auto",
          "response": {
            "input_transcription": false,
            "text": true,
            "audio": false,
            "output_audio": null,
            "voice": null,
            "emotion": null
          },
          "generation": { "text": {}, "temperature": 0.7 }
        }
      }
    },
    {
      "name": "conversation_active is always retryable",
      "direction": "server",
      "expected_rule": "conversation_active_must_be_retryable",
      "message": {
        "v": 2,
        "type": "error",
        "event_id": "10000000-0000-4000-8000-000000000007",
        "request_id": "00112233-4455-6677-8899-aabbccddeeff",
        "sent_at_ms": 7,
        "payload": {
          "code": "conversation_active",
          "message": "conversation is active",
          "stage": "routing",
          "stream": null,
          "terminal": true,
          "retryable": false,
          "fatal": false,
          "retry_after_ms": null,
          "details": {}
        }
      }
    },
    {
