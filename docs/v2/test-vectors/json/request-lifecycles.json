{
  "format_version": 2,
  "cases": [
    {
      "name": "asr_only streams and revises while recording",
      "valid": true,
      "events": [
        {"type": "request.accepted", "payload": {"mode": "asr_only"}},
        {"type": "output.text.delta", "payload": {"stage": "asr", "sequence": 0, "delta": "hello"}},
        {"type": "output.text.snapshot", "payload": {"stage": "asr", "text": "Hello", "final": false}},
        {"type": "output.text.delta", "payload": {"stage": "asr", "sequence": 1, "delta": "."}},
        {"type": "input.committed", "payload": {}},
        {"type": "output.text.snapshot", "payload": {"stage": "asr", "text": "Hello.", "final": true}},
        {"type": "session.ping", "payload": {"nonce": "hb-1"}},
        {"type": "request.done", "payload": {"mode": "asr_only", "final_text": "Hello."}}
      ]
    },
    {
      "name": "non-streaming ASR uses the same asr_only protocol",
      "valid": true,
      "events": [
        {"type": "request.accepted", "payload": {"mode": "asr_only"}},
        {"type": "input.committed", "payload": {}},
        {"type": "output.text.snapshot", "payload": {"stage": "asr", "text": "Final.", "final": true}},
        {"type": "request.done", "payload": {"mode": "asr_only", "final_text": "Final."}}
      ]
    },
    {
      "name": "asr_llm streams both stages with an explicit stage transition",
      "valid": true,
      "events": [
        {"type": "request.accepted", "payload": {"mode": "asr_llm"}},
        {"type": "output.text.delta", "payload": {"stage": "asr", "sequence": 0, "delta": "raw"}},
        {"type": "output.text.snapshot", "payload": {"stage": "asr", "text": "raw draft", "final": false}},
        {"type": "input.committed", "payload": {}},
        {"type": "output.text.snapshot", "payload": {"stage": "asr", "text": "raw final", "final": false}},
        {"type": "output.text.snapshot", "payload": {"stage": "llm", "text": "", "final": false}},
        {"type": "output.text.delta", "payload": {"stage": "llm", "sequence": 0, "delta": "polished"}},
        {"type": "output.text.delta", "payload": {"stage": "llm", "sequence": 1, "delta": " text"}},
        {"type": "output.text.snapshot", "payload": {"stage": "llm", "text": "Polished text.", "final": true}},
        {"type": "request.done", "payload": {"mode": "asr_llm", "final_text": "Polished text."}}
      ]
    },
    {
      "name": "non-streaming LLM still emits the explicit stage transition",
      "valid": true,
      "events": [
        {"type": "request.accepted", "payload": {"mode": "asr_llm"}},
        {"type": "input.committed", "payload": {}},
        {"type": "output.text.snapshot", "payload": {"stage": "asr", "text": "raw", "final": false}},
        {"type": "output.text.snapshot", "payload": {"stage": "llm", "text": "", "final": false}},
        {"type": "output.text.snapshot", "payload": {"stage": "llm", "text": "polished", "final": true}},
        {"type": "request.done", "payload": {"mode": "asr_llm", "final_text": "polished"}}
      ]
    },
    {
      "name": "final ASR snapshot cannot precede input committed",
      "valid": false,
      "expected_rule": "final_before_input_committed",
      "events": [
        {"type": "request.accepted", "payload": {"mode": "asr_only"}},
        {"type": "output.text.snapshot", "payload": {"stage": "asr", "text": "early", "final": true}}
      ]
    },
    {
      "name": "asr_llm ASR snapshot cannot be final",
      "valid": false,
      "expected_rule": "snapshot_mode_mismatch",
      "events": [
        {"type": "request.accepted", "payload": {"mode": "asr_llm"}},
        {"type": "input.committed", "payload": {}},
        {"type": "output.text.snapshot", "payload": {"stage": "asr", "text": "raw", "final": true}}
      ]
    },
    {
      "name": "LLM stage transition must clear the temporary text",
      "valid": false,
      "expected_rule": "invalid_llm_stage_transition",
      "events": [
        {"type": "request.accepted", "payload": {"mode": "asr_llm"}},
        {"type": "input.committed", "payload": {}},
        {"type": "output.text.snapshot", "payload": {"stage": "asr", "text": "raw", "final": false}},
        {"type": "output.text.snapshot", "payload": {"stage": "llm", "text": "prefix", "final": false}}
      ]
    },
    {
      "name": "LLM delta requires the stage transition snapshot",
      "valid": false,
      "expected_rule": "llm_output_before_stage_transition",
      "events": [
        {"type": "request.accepted", "payload": {"mode": "asr_llm"}},
        {"type": "input.committed", "payload": {}},
        {"type": "output.text.snapshot", "payload": {"stage": "asr", "text": "raw", "final": false}},
        {"type": "output.text.delta", "payload": {"stage": "llm", "sequence": 0, "delta": "polished"}}
      ]
    },
    {
      "name": "LLM requires a complete ASR snapshot after the last ASR delta",
      "valid": false,
      "expected_rule": "llm_output_before_asr_complete",
      "events": [
        {"type": "request.accepted", "payload": {"mode": "asr_llm"}},
        {"type": "input.committed", "payload": {}},
        {"type": "output.text.snapshot", "payload": {"stage": "asr", "text": "draft", "final": false}},
        {"type": "output.text.delta", "payload": {"stage": "asr", "sequence": 0, "delta": " late"}},
        {"type": "output.text.snapshot", "payload": {"stage": "llm", "text": "", "final": false}}
      ]
    },
    {
      "name": "ASR output cannot resume after LLM starts",
      "valid": false,
      "expected_rule": "asr_output_after_llm_started",
      "events": [
        {"type": "request.accepted", "payload": {"mode": "asr_llm"}},
        {"type": "input.committed", "payload": {}},
        {"type": "output.text.snapshot", "payload": {"stage": "asr", "text": "raw", "final": false}},
        {"type": "output.text.snapshot", "payload": {"stage": "llm", "text": "", "final": false}},
        {"type": "output.text.delta", "payload": {"stage": "asr", "sequence": 0, "delta": "late"}}
      ]
    },
    {
      "name": "done mode must match accepted mode",
      "valid": false,
      "expected_rule": "done_mode_mismatch",
      "events": [
        {"type": "request.accepted", "payload": {"mode": "asr_only"}},
        {"type": "input.committed", "payload": {}},
        {"type": "output.text.snapshot", "payload": {"stage": "asr", "text": "final", "final": true}},
        {"type": "request.done", "payload": {"mode": "asr_llm", "final_text": "final"}}
      ]
    },
    {
      "name": "request event cannot appear between final snapshot and done",
      "valid": false,
      "expected_rule": "final_not_followed_by_done",
      "events": [
        {"type": "request.accepted", "payload": {"mode": "asr_only"}},
        {"type": "input.committed", "payload": {}},
        {"type": "output.text.snapshot", "payload": {"stage": "asr", "text": "final", "final": true}},
        {"type": "output.text.delta", "payload": {"stage": "asr", "sequence": 0, "delta": "late"}},
        {"type": "request.done", "payload": {"mode": "asr_only", "final_text": "final"}}
      ]
    },
    {
      "name": "request events after terminal are rejected",
      "valid": false,
      "expected_rule": "event_after_terminal",
      "events": [
        {"type": "request.accepted", "payload": {"mode": "asr_llm"}},
        {"type": "error", "payload": {"terminal": true, "fatal": false}},
        {"type": "output.text.snapshot", "payload": {"stage": "llm", "text": "late", "final": true}}
      ]
    },
    {
      "name": "cancel after final loses race and done remains terminal",
      "valid": true,
      "events": [
        {"type": "request.accepted", "payload": {"mode": "asr_only"}},
        {"type": "input.committed", "payload": {}},
        {"type": "output.text.snapshot", "payload": {"stage": "asr", "text": "final", "final": true}},
        {"type": "request.cancel", "payload": {"reason": "user_cancelled"}},
        {"type": "request.done", "payload": {"mode": "asr_only", "final_text": "final"}}
      ]
    },
    {
      "name": "cancelled cannot replace done after final",
      "valid": false,
      "expected_rule": "final_not_followed_by_done",
      "events": [
        {"type": "request.accepted", "payload": {"mode": "asr_only"}},
        {"type": "input.committed", "payload": {}},
        {"type": "output.text.snapshot", "payload": {"stage": "asr", "text": "final", "final": true}},
        {"type": "request.cancel", "payload": {"reason": "user_cancelled"}},
        {"type": "request.cancelled", "payload": {}}
      ]
    },
    {
      "name": "cancel before final may win",
      "valid": true,
      "events": [
        {"type": "request.accepted", "payload": {"mode": "asr_llm"}},
        {"type": "output.text.delta", "payload": {"stage": "asr", "sequence": 0, "delta": "partial"}},
        {"type": "request.cancel", "payload": {"reason": "user_cancelled"}},
        {"type": "request.cancelled", "payload": {}}
      ]
    }
  ]
}
